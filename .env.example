# ------------------------------------------------------------------
# REQUIRED — the app fails to boot or work without these
# ------------------------------------------------------------------

# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-value

DEBUG=false

# Your exact hostname. NO wildcard: *.onrender.com matches other tenants' apps.
ALLOWED_HOSTS=cert-master.onrender.com

# Render PostgreSQL "External Database URL" (settings force sslmode=require).
DATABASE_URL=postgres://user:password@host:5432/dbname
# Local docker-compose alternative — leave DATABASE_URL unset and use these:
# POSTGRES_DB=authdb
# POSTGRES_USER=authuser
# POSTGRES_PASSWORD=authpass

# Supabase storage: the backends validate these at startup.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
# SUPABASE_MEDIA_BUCKET=media
# SUPABASE_STATIC_BUCKET=static

# Full frontend origin — used to build QR verification URLs.
CERT_FRONTEND_URL=https://oauther-fqj8.vercel.app

# Browser origins allowed to call the API (comma-separated for multiple).
CORS_ALLOWED_ORIGINS=https://oauther-fqj8.vercel.app
CSRF_TRUSTED_ORIGINS=https://oauther-fqj8.vercel.app

# Email OTP delivery. Console backend is rejected when DEBUG=false.
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@yourdomain.com
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
# For port 465 instead of STARTTLS/587: EMAIL_USE_SSL=true, EMAIL_USE_TLS=false

# Alternative Resend provider (EMAIL_PROVIDER=resend):
# RESEND_API_KEY=re_your_api_token
# RESEND_API_URL=https://api.resend.com/emails
# DEFAULT_FROM_EMAIL=no-reply@your-verified-resend-domain.com

# ------------------------------------------------------------------
# OPTIONAL tunables (defaults shown)
# ------------------------------------------------------------------
PAGE_SIZE=50
LOG_LEVEL=INFO
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# WEB_CONCURRENCY=2
# OTP_LENGTH=6
# OTP_EXPIRY_MINUTES=10
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_ATTEMPTS=5
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true
# SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
# X_FRAME_OPTIONS=DENY

# ------------------------------------------------------------------
# LOCAL ONLY — never set in production
# ------------------------------------------------------------------
# LOCAL_HTTP=true   # run a DEBUG=false build over plain http://localhost:8000
