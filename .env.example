# Render Deployment Environment Variables
# Copy to .env and fill values

# Django Secret Key (generate new for prod: https://djecrety.ir/)
SECRET_KEY=your-secret-key-here

# Debug (false for production)
DEBUG=false

# Allowed Hosts
ALLOWED_HOSTS=yourapp.onrender.com,.onrender.com

# Render PostgreSQL (from Render dashboard)
DATABASE_URL=postgres://user:pass@host:port/db

# Alternative manual Postgres vars (local docker-compose)
# POSTGRES_DB=authdb
# POSTGRES_USER=authuser
# POSTGRES_PASSWORD=authpass

# App URL for QR verification
PUBLIC_BASE_URL=https://yourapp.onrender.com

# ------------------------------------------------------------------
# Email for signup OTP codes: choose smtp | resend | console
# ------------------------------------------------------------------
# Default (no EMAIL_PROVIDER set): SMTP when EMAIL_HOST is set, else console.
# EMAIL_PROVIDER=smtp
EMAIL_PROVIDER=smtp

# --- SMTP (used when EMAIL_PROVIDER=smtp) ---
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@yourdomain.com
EMAIL_HOST_PASSWORD=your-smtp-password
# Use TLS on 587 (default), or set EMAIL_USE_SSL=true for port 465.
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# --- Resend API (optional alternative; set EMAIL_PROVIDER=resend) ---
# Get a token from https://resend.com/api-keys and verify the sending domain.
# The verification domain must match DEFAULT_FROM_EMAIL.
# RESEND_API_KEY=re_your_api_token
# RESEND_API_URL=https://api.resend.com/emails
# RESEND_TIMEOUT=10

# OTP behaviour (optional, defaults shown)
# OTP_LENGTH=6
# OTP_EXPIRY_MINUTES=10
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_ATTEMPTS=5
# OTP_EMAIL_SUBJECT=Your verification code

# ------------------------------------------------------------------
# HTTPS / security headers
# ------------------------------------------------------------------
# Production defaults: HTTPS redirect, 1-year HSTS, Secure cookies.
# To run a production-like build over plain HTTP on your machine
# (DEBUG=false on http://localhost:8000), set LOCAL_HTTP=true.
# NEVER set LOCAL_HTTP on a real deployment.
# LOCAL_HTTP=true
#
# Individual overrides (optional):
# SECURE_SSL_REDIRECT=false
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false
# SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
# X_FRAME_OPTIONS=DENY
